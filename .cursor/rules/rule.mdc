## Example 1 — **Unified RAG Agent With Tools + LangGraph Workflow**
```python
from langchain_core.tools import tool
from langchain_openai import ChatOpenAI
from langgraph.graph import StateGraph, END
from typing import TypedDict

@tool
def search_docs(query: str) -> str:
    """Mock vector search tool."""
    return f"Top doc for '{query}'"

class WorkflowState(TypedDict):
    query: str
    doc: str
    answer: str

def retrieve(state: WorkflowState):
    return {"doc": search_docs(state["query"])}

def answer(state: WorkflowState):
    llm = ChatOpenAI(model="gpt-4.1")
    result = llm.invoke(f"Use this doc: {state['doc']} to answer the query.")
    return {"answer": result.content}

graph = StateGraph(WorkflowState)
graph.add_node("retrieve", retrieve)
graph.add_node("answer", answer)

graph.add_edge("retrieve", "answer")
graph.add_edge("answer", END)

app = graph.compile()
print(app.invoke({"query": "What is LangGraph?"}))
